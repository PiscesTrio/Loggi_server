# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交真值。
# ===== 数据库（对应 application.yaml 的 spring.datasource.*） =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loggi
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# ===== Redis（验证码 TTL 存储 + 限流原子计数；docker compose 下走服务名 redis） =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== 验证码策略（都是安全参数，改之前想清楚） =====
# 有效期 5 分钟；更长 = 攻击者有更长时间去猜
VERIFICATION_CODE_TTL_SECONDS=300
# 同一邮箱两次发送的最小间隔；没有它这个公开端点就是一台对着任意地址的邮件中继
VERIFICATION_SEND_COOLDOWN_SECONDS=60
# 校验失败上限与锁定时长；6 位码是一百万种可能，前提是猜测次数有界
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_LOCK_SECONDS=900

# ===== JWT（对应 application.yaml 的 jwt.secret；注意 jjwt 0.12.x 起 HS256 要求密钥 >= 32 字节/256 位） =====
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET_VALUE

# ===== 邮件（对应 application.yaml 的 spring.mail.*） =====
# 主机、端口、传输方式三者绑在一起：465 = 隐式 TLS（连上就是加密的），
# 587 = STARTTLS（先明文连接，再用一条命令升级）。配错组合不会优雅降级，只会挂住或报协议错。
# 密码填服务商的“应用专用密码/授权码”，不是邮箱登录密码——多数服务商开了两步验证后前者才是唯一能用的。
MAIL_HOST=smtp.example.invalid
MAIL_PORT=465
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-authorization-code

# ===== 调试开关（默认关，只在本地排查时开） =====
# JPA_SHOW_SQL=true 会把每条 SQL 及其参数打到 stdout，含审计日志自己的 INSERT
JPA_SHOW_SQL=false
# MAIL_DEBUG=true 会把整段 SMTP 会话打到 stdout，含 AUTH 那一行（即邮箱密码）
MAIL_DEBUG=false
