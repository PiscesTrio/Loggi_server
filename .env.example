# Copy to .env and fill in real values. .env is gitignored — never commit real ones.

# ===== Database (maps to spring.datasource.* in application.yaml) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loggi
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# ===== Redis (verification-code TTL storage + atomic rate-limit counters; under
#       docker compose this is the service name `redis`) =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Verification codes (every one of these is a security parameter — think before
#       changing one) =====
# Five minutes. Longer means longer for an attacker to guess in.
VERIFICATION_CODE_TTL_SECONDS=300
# Minimum gap between two sends to the same address. Without it, this public endpoint is
# a mail relay pointed at any address you like.
VERIFICATION_SEND_COOLDOWN_SECONDS=60
# Failed-attempt ceiling and lockout. A six-digit code is a million possibilities, but
# only while the number of guesses is bounded.
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_LOCK_SECONDS=900

# ===== JWT (maps to jwt.secret in application.yaml; from jjwt 0.12.x onward HS256
#       requires a key of at least 32 bytes / 256 bits) =====
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET_VALUE

# ===== Mail (maps to spring.mail.* in application.yaml) =====
# Host, port and transport travel together: 465 is implicit TLS (encrypted from the moment
# you connect), 587 is STARTTLS (plaintext first, then one command upgrades it). A
# mismatched combination does not degrade gracefully — it hangs, or reports a protocol error.
# The password is the provider's app-specific password, not the mailbox login password —
# with two-factor enabled, most providers make the former the only one that works.
MAIL_HOST=smtp.example.invalid
MAIL_PORT=465
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-specific-password

# ===== Debug switches (off by default; on only while diagnosing locally) =====
# JPA_SHOW_SQL=true prints every SQL statement and its parameters to stdout, including the
# audit log's own INSERTs.
JPA_SHOW_SQL=false
# MAIL_DEBUG=true prints the whole SMTP conversation to stdout, including the AUTH line —
# which is the mailbox password.
MAIL_DEBUG=false
