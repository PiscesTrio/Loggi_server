<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>loggi-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
    </parent>

    <properties>
        <java.version>21</java.version>
        <jwt.version>0.13.0</jwt.version>
    </properties>

    <!--
      S00's explicit testcontainers-bom import is gone: Spring Boot has managed org.testcontainers
      since 3.1, so re-importing it is one more pinned version drifting from the parent BOM
      (S00's own comment already announced this slice would drop it).
    -->

    <dependencies>

        <!--SpringBoot dependencies-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--SpringData dependency-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--SpringSecurity dependency-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--Email sending dependency-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Version left to the spring-boot-dependencies BOM: pinning it drifts from the parent BOM and collides with Spring Framework on upgrades -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context-support</artifactId>
        </dependency>

        <!--
          jjwt ships as three artifacts: api on the compile path, impl and jackson at runtime only.
          Application code therefore sees nothing but the io.jsonwebtoken.* interfaces, and reaching
          for an internal implementation class fails to compile.
          The old single-jar jjwt 0.9.1 was last released in 2018, and its signWith(alg, String)
          accepted a key of any length without complaint — CHANGE_ME, 64 bits, was enough to sign
          "valid" tokens. The current API takes a SecretKey built by Keys.hmacShaKeyFor(byte[]),
          which throws WeakKeyException below 256 bits: a weak key becomes a startup failure
          instead of a silent runtime exposure.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          The javax.xml.bind:jaxb-api that S01 pinned for jjwt 0.9.1 is gone with this upgrade.
          The current jjwt serialises with Jackson and never touches
          javax.xml.bind.DatatypeConverter, so that lone javax artifact had no reason to remain in
          a codebase that has otherwise finished its jakarta migration.
        -->

        <!--Bean Validation. The constraints live on the request DTOs, so a malformed request
            is refused by the framework before a controller method body runs - rather than by
            an `if` somewhere in a service, which is where this project's validation lived when
            it existed at all.-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--Actuator: /actuator/health is what a container orchestrator probes. Without it a
            deployment has no way to ask whether the application is actually serving.-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--springdoc generates the OpenAPI document from the controllers themselves, so the
            documentation cannot drift from the code the way a hand-written file does. Version
            pinned here because springdoc is not in Spring Boot's BOM; the 3.x line is the one
            built against Spring Boot 4.-->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!--Flyway owns the schema from S08 on. Version comes from the parent BOM, never
            pinned here: Flyway and the JDBC driver have to agree about the database, and the
            BOM is what keeps that pair consistent across a Spring Boot upgrade.
            flyway-mysql is a separate artifact - flyway-core alone knows no MySQL dialect and
            fails at startup with "Unsupported Database: MySQL".-->
        <!--Spring Boot 4 split the autoconfigurations out of spring-boot-autoconfigure into
            per-technology modules, so flyway-core on its own gives you the migration engine and
            nothing that runs it: the application starts, Flyway never executes, and the first
            symptom is Hibernate's "Schema validation: missing table [admin]" — which reads like a
            broken migration rather than an absent one. This module carries FlywayAutoConfiguration.-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!--MySQL driver: since SB3 the parent BOM manages only the new GAV com.mysql:mysql-connector-j; the old mysql:mysql-connector-java is unmanaged-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--lombok: version left to the parent BOM (1.18.24 predates the current JDK baseline; its annotation processor can break)-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>



        <!--
          The explicit com.fasterxml.jackson.core:jackson-databind declaration is gone: SB4 ships
          Jackson 3, databind's groupId moved to tools.jackson, and the parent BOM no longer manages
          the old GAV. Nothing imports databind directly — only
          com.fasterxml.jackson.annotation.JsonFormat, and jackson-annotations is the migration
          guide's one exception keeping its old groupId — so spring-boot-starter-web's JSON suffices.
        -->

        <!-- ===== S00 safety net: test dependencies (test scope only, never in the production artifact) ===== -->
        <!--
          SB4 split the test slices per technology: spring-boot-starter-test no longer brings
          @WebMvcTest / @DataJpaTest; instead pull the -test starter of each technology under test.
          Those bring spring-boot-starter-test transitively, so it needs no explicit declaration.
          Official wording: "you should list the starters of the technologies that are under test for the module".
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Redis: TTL storage for verification codes and atomic counters for rate limiting.
          A one-time code is cache data, not business data - short-lived, single-use, and
          write-heavy. SET ... EX expires it without an application-level `exp` column that
          nothing ever cleans up, and INCR/EXPIRE give the send cooldown and the failed-attempt
          lockout an atomicity that a read-then-write over JPA cannot.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Testcontainers 2.0 (managed by the SB4 parent BOM) renamed every module artifactId:
          junit-jupiter -> testcontainers-junit-jupiter, mysql -> testcontainers-mysql. The old names
          fail with 'dependencies.dependency.version' is missing — the new BOM has no entry for them.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          GreenMail: an in-process SMTP server, so a test can assert that a message was
          actually sent and read the code out of its body. The whole reason this slice
          exists is that `mailSender.send(...)` sat commented out and nothing noticed.
        -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>2.1.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
              ===== S00 safety net: run *IT integration tests in the verify phase (needs Docker / Testcontainers) =====
              spring-boot-starter-parent binds failsafe's integration-test and verify goals in
              <pluginManagement>, but pluginManagement only supplies defaults without activating the
              plugin, so the project must "declare" it here for *IT to run. Measured: deleting the
              <executions> block below still runs AdminRepositoryIT via the parent pom's default
              execution — the explicit form is kept purely for self-documentation, so we do not rely
              on those defaults.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ===== S19: formatting is checked, not discussed =====
                 `mvn spotless:check` fails the build on a file that is not formatted, and
                 `mvn spotless:apply` fixes it. Not because the style is worth arguing about
                 — because arguing about it in review is worse than any style. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.44.5</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
            </plugin>

            <!-- ===== S00 safety net: JaCoCo coverage report + gate (threshold starts at 0, raised step by step in later slices) ===== -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!--
                                              Measured, not guessed — both run modes:
                                                ./mvnw verify -DskipITs -> 177/582 = 30.41% (28 unit tests)
                                                ./mvnw verify           -> 208/582 = 35.74% (+6 Testcontainers ITs)
                                              failsafe inherits jacoco's argLine, so *IT really does count.
                                              The gate takes the lower bound so a local run with ITs skipped and a
                                              full CI run both pass.
                                              Ratchet: each later slice raises it one notch, never lowers it.
                                              S00 0.18 -> S02 0.30. Part of the jump is the security tests, part is
                                              the denominator: deleting ResponseUtil and the static JwtTokenUtil
                                              took 179 lines out of the bundle.
                                            -->
                                            <minimum>0.50</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
